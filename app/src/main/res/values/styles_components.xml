<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Linha de opção em lista (perfil, folhas): botão de texto alinhado à esquerda, 48 dp. -->
    <style name="Widget.Leia.ListAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.Leia.Body</item>
        <item name="android:textColor">@color/leia_on_background</item>
        <item name="iconTint">@color/leia_on_surface_variant</item>
        <item name="iconPadding">@dimen/space_m</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Leia.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
        <item name="android:layout_marginBottom">@dimen/space_xs</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Leia.Title</item>
        <item name="android:textColor">@color/leia_on_background</item>
    </style>

    <style name="ShapeAppearance.Leia.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Título de seção do Início (Nova Mobile: Title 22 SemiBold) -->
    <style name="Widget.Leia.HomeSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/screen_margin</item>
        <item name="android:layout_marginEnd">@dimen/screen_margin</item>
        <item name="android:layout_marginTop">@dimen/space_xl</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Leia.Headline</item>
        <item name="android:textColor">@color/leia_on_background</item>
    </style>

    <!-- Números do cabeçalho do Perfil -->
    <style name="Widget.Leia.HeaderMetric" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Leia.HeaderMetricValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Leia.Headline</item>
        <item name="android:textColor">@color/leia_on_header</item>
    </style>

    <style name="Widget.Leia.HeaderMetricLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Leia.Caption</item>
        <item name="android:textColor">@color/leia_hero_secondary</item>
    </style>
</resources>
