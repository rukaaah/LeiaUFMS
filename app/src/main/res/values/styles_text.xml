<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rótulo acima do campo (briefing D2: nada de placeholder no lugar do rótulo). -->
    <style name="Widget.Leia.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:layout_marginBottom">@dimen/space_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.Leia.Label</item>
        <item name="android:textColor">@color/leia_on_background</item>
    </style>

    <style name="Widget.Leia.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- Campo com lista (curso): seta de abrir a lista, filtro ao digitar -->
    <style name="Widget.Leia.Field.Dropdown">
        <item name="endIconMode">dropdown_menu</item>
    </style>

    <style name="Widget.Leia.FieldInput" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Leia.Body</item>
        <item name="android:textColor">@color/leia_on_background</item>
    </style>

    <!-- Erro de grupo de escolha (chips), no mesmo estilo do erro de TextInputLayout. -->
    <style name="Widget.Leia.InlineError" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Leia.Caption</item>
        <item name="android:textColor">@color/leia_error</item>
        <item name="android:visibility">gone</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
</resources>
