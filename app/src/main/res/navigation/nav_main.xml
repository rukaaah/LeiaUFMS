<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/exploreFragment">

    <fragment
        android:id="@+id/exploreFragment"
        android:name="br.ufms.leiaufms.ui.explore.ExploreFragment"
        android:label="@string/tab_explore" />

    <fragment
        android:id="@+id/feedFragment"
        android:name="br.ufms.leiaufms.ui.feed.FeedFragment"
        android:label="@string/tab_feed" />

    <fragment
        android:id="@+id/tradesFragment"
        android:name="br.ufms.leiaufms.ui.trade.TradesFragment"
        android:label="@string/tab_trades" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="br.ufms.leiaufms.ui.profile.ProfileFragment"
        android:label="@string/tab_profile" />

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="br.ufms.leiaufms.ui.profile.ProfileFragment"
        android:label="@string/title_user_profile">
        <argument
            android:name="userId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="br.ufms.leiaufms.ui.profile.EditProfileFragment"
        android:label="@string/title_edit_profile" />

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="br.ufms.leiaufms.ui.profile.ChangePasswordFragment"
        android:label="@string/title_change_password" />

    <fragment
        android:id="@+id/inboxFragment"
        android:name="br.ufms.leiaufms.ui.inbox.InboxFragment"
        android:label="@string/title_inbox" />

    <fragment
        android:id="@+id/listingDetailFragment"
        android:name="br.ufms.leiaufms.ui.listing.ListingDetailFragment"
        android:label="@string/title_listing">
        <argument
            android:name="anuncioId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/newListingFragment"
        android:name="br.ufms.leiaufms.ui.listing.NewListingFragment"
        android:label="@string/title_new_listing">
        <argument
            android:name="anuncioId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/tradeDetailFragment"
        android:name="br.ufms.leiaufms.ui.trade.TradeDetailFragment"
        android:label="@string/title_trade">
        <argument
            android:name="pedidoId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/meetingFragment"
        android:name="br.ufms.leiaufms.ui.meeting.MeetingFragment"
        android:label="@string/title_meeting">
        <argument
            android:name="pedidoId"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="gerenciar"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>
</navigation>
