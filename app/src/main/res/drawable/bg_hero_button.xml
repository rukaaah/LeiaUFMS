<?xml version="1.0" encoding="utf-8"?>
<!-- Botão circular sobre a capa (Airbnb icon-button-outline): fundo de superfície e borda fina -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="4dp">
    <shape android:shape="oval">
        <solid android:color="@color/leia_surface" />
        <stroke android:width="1dp" android:color="@color/leia_outline_variant" />
    </shape>
</inset>
