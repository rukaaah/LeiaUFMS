<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Widget.Leia.FieldLabel"
            android:text="@string/label_post_type" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/types"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/t_dica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_type_dica" />

            <com.google.android.material.chip.Chip
                android:id="@+id/t_procuro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_type_procuro" />

            <com.google.android.material.chip.Chip
                android:id="@+id/t_doacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_type_doacao" />

            <com.google.android.material.chip.Chip
                android:id="@+id/t_troca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_type_troca" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/error_type"
            style="@style/Widget.Leia.InlineError" />

        <TextView
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_title"
            android:text="@string/label_post_book" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_title"
            style="@style/Widget.Leia.Field"
            app:helperText="@string/helper_post_book">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/input_title"
                style="@style/Widget.Leia.FieldInput"
                android:completionThreshold="2"
                android:hint="@string/label_title"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="150"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_author"
            style="@style/Widget.Leia.Field"
            android:layout_marginTop="@dimen/space_xs">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_author"
                style="@style/Widget.Leia.FieldInput"
                android:contentDescription="@string/label_author"
                android:hint="@string/label_author"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_text"
            android:text="@string/label_post_text" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_text"
            style="@style/Widget.Leia.Field"
            app:counterEnabled="true"
            app:counterMaxLength="500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_text"
                style="@style/Widget.Leia.FieldInput"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_publish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/action_publish_post" />
    </LinearLayout>
</ScrollView>
