<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/cover"
                layout="@layout/view_cover"
                android:layout_width="@dimen/cover_width_large"
                android:layout_height="@dimen/cover_height_large" />

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Leia.BookTitleLarge"
                    android:textColor="@color/leia_on_background" />

                <TextView
                    android:id="@+id/author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Leia.Body"
                    android:textColor="@color/leia_on_surface_variant" />

                <TextView
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                    android:textColor="@color/leia_on_background" />

                <TextView
                    android:id="@+id/modality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Leia.Title"
                    android:textColor="@color/leia_primary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/location_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_walk"
                android:drawablePadding="@dimen/space_xxs"
                android:paddingStart="@dimen/space_xs"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.Leia.Label"
                android:textColor="@color/leia_on_primary_container"
                android:visibility="gone" />

            <TextView
                android:id="@+id/walk_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/walk_note"
                android:textAppearance="@style/TextAppearance.Leia.Caption"
                android:textColor="@color/leia_on_surface_variant"
                android:visibility="gone" />

            <TextView
                android:id="@+id/location_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                android:textColor="@color/leia_on_background"
                app:drawableStartCompat="@drawable/ic_place" />
        </LinearLayout>

        <TextView
            style="@style/Widget.Leia.SectionTitle"
            android:text="@string/label_owner" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/owner_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_s">

                <include
                    android:id="@+id/owner_avatar"
                    layout="@layout/view_avatar"
                    android:layout_width="@dimen/avatar_small"
                    android:layout_height="@dimen/avatar_small" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/owner_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Leia.Title"
                        android:textColor="@color/leia_on_background" />

                    <TextView
                        android:id="@+id/owner_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Leia.Caption"
                        android:textColor="@color/leia_on_surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/status_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Leia.Body"
            android:textColor="@color/leia_on_surface_variant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_secondary"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
