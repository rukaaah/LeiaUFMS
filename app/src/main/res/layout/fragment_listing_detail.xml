<?xml version="1.0" encoding="utf-8"?>
<!-- Livro (briefing v2): capa primeiro, confiança antes do pedido, barra de ação fixa (referência Airbnb). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_l">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/cover_hero_height"
                android:background="@color/leia_surface_container">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/cover_detail_width"
                    android:layout_height="@dimen/cover_detail_height"
                    android:layout_gravity="center"
                    app:cardElevation="@dimen/elevation_hero"
                    app:strokeWidth="0dp">

                    <include
                        android:id="@+id/cover"
                        layout="@layout/view_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>

                <ImageButton
                    android:id="@+id/heart"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/bg_heart_inset"
                    android:padding="@dimen/heart_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_favorite_border" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Leia.BookTitleLarge"
                    android:textColor="@color/leia_on_background" />

                <TextView
                    android:id="@+id/author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Leia.Body"
                    android:textColor="@color/leia_on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_obra"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:text="@string/action_see_all_copies"
                    app:icon="@drawable/ic_library" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/facts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s" />

                <TextView
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/modality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    style="@style/Widget.Leia.SectionTitle"
                    android:text="@string/book_location_title" />

                <LinearLayout
                    android:id="@+id/location_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_notice"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <TextView
                        android:id="@+id/distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_walk"
                        android:drawablePadding="@dimen/space_xxs"
                        android:paddingStart="@dimen/space_xs"
                        android:paddingTop="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xxs"
                        android:textAppearance="@style/TextAppearance.Leia.Label"
                        android:textColor="@color/leia_on_success_container"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/location_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:drawablePadding="@dimen/space_xs"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Leia.Body"
                        android:textColor="@color/leia_on_background"
                        app:drawableStartCompat="@drawable/ic_place" />

                    <TextView
                        android:id="@+id/walk_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/walk_note"
                        android:textAppearance="@style/TextAppearance.Leia.Caption"
                        android:textColor="@color/leia_on_surface_variant"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Leia.SectionTitle"
                    android:text="@string/label_owner" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/owner_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_m">

                        <include
                            android:id="@+id/owner_avatar"
                            layout="@layout/view_avatar"
                            android:layout_width="@dimen/avatar_medium"
                            android:layout_height="@dimen/avatar_medium" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/owner_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Leia.Title"
                                android:textColor="@color/leia_on_background" />

                            <TextView
                                android:id="@+id/owner_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Leia.Caption"
                                android:textColor="@color/leia_on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/owner_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Leia.Display"
                                android:textColor="@color/leia_on_background" />

                            <TextView
                                android:id="@+id/owner_rating_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/trust_rating_label"
                                android:textAppearance="@style/TextAppearance.Leia.Caption"
                                android:textColor="@color/leia_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/proof_wishes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:drawablePadding="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                    android:textColor="@color/leia_on_background"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_favorite_border" />

                <TextView
                    android:id="@+id/proof_hands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:drawablePadding="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                    android:textColor="@color/leia_on_background"
                    android:background="?attr/selectableItemBackground"
                    android:minHeight="@dimen/touch_target"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_history" />

                <TextView
                    android:id="@+id/courses_title"
                    style="@style/Widget.Leia.SectionTitle"
                    android:text="@string/book_courses"
                    android:visibility="gone" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/courses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/status_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_notice"
                    android:padding="@dimen/space_m"
                    android:textAppearance="@style/TextAppearance.Leia.Body"
                    android:textColor="@color/leia_on_background"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/copies_title"
                style="@style/Widget.Leia.HomeSection"
                android:text="@string/book_other_copies"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/copies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_action_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:id="@+id/bar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Leia.BodySmall"
            android:textColor="@color/leia_on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_secondary"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
