<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/label_title"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_title"
            android:text="@string/label_title" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_title"
            style="@style/Widget.Leia.Field">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_title"
                style="@style/Widget.Leia.FieldInput"
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLength="150" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_author"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_author"
            android:text="@string/label_author" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_author"
            style="@style/Widget.Leia.Field">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_author"
                style="@style/Widget.Leia.FieldInput"
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="textCapWords|textPersonName"
                android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_isbn"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_isbn"
            android:text="@string/label_isbn" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_isbn"
            style="@style/Widget.Leia.Field"
            app:helperText="@string/helper_isbn">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_isbn"
                style="@style/Widget.Leia.FieldInput"
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="text|textNoSuggestions"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_edition"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_edition"
            android:text="@string/label_edition" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_edition"
            style="@style/Widget.Leia.Field"
            app:helperText="@string/helper_edition">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_edition"
                style="@style/Widget.Leia.FieldInput"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_condition"
            style="@style/Widget.Leia.FieldLabel"
            android:text="@string/label_condition" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/cond_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/condition_new" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cond_good"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/condition_good" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cond_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/condition_used" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cond_worn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/condition_worn" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/error_condition"
            style="@style/Widget.Leia.InlineError" />

        <TextView
            android:id="@+id/label_modality"
            style="@style/Widget.Leia.FieldLabel"
            android:text="@string/label_modality" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_modality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/mod_trade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modality_trade" />

            <com.google.android.material.chip.Chip
                android:id="@+id/mod_donation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modality_donation" />

            <com.google.android.material.chip.Chip
                android:id="@+id/mod_both"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modality_both" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/error_modality"
            style="@style/Widget.Leia.InlineError" />

        <TextView
            style="@style/Widget.Leia.FieldLabel"
            android:text="@string/label_listing_photo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/cover"
                layout="@layout/view_cover" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_photo"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:text="@string/action_add_photo"
                app:icon="@drawable/ic_camera" />
        </LinearLayout>

        <TextView
            style="@style/Widget.Leia.FieldLabel"
            android:text="@string/label_location" />

        <RadioGroup
            android:id="@+id/radio_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@id/loc_none">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/loc_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/location_option_current"
                android:textAppearance="@style/TextAppearance.Leia.Body" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/loc_point"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/location_option_point"
                android:textAppearance="@style/TextAppearance.Leia.Body" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/loc_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/location_option_none"
                android:textAppearance="@style/TextAppearance.Leia.Body" />
        </RadioGroup>

        <TextView
            android:id="@+id/location_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Leia.BodySmall"
            android:textColor="@color/leia_on_surface_variant"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_point"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/label_choose_point"
            android:visibility="gone">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/input_point"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="@dimen/touch_target"
                android:textAppearance="@style/TextAppearance.Leia.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_publish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/action_publish" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:indeterminate="true"
            android:visibility="invisible" />
    </LinearLayout>
</ScrollView>
