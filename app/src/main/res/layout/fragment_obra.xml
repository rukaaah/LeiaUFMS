<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <!-- Capa grande de ponta a ponta com ações por cima (mesma estrutura do Livro) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/cover_hero_height"
            android:layout_marginStart="@dimen/screen_margin_negative"
            android:layout_marginEnd="@dimen/screen_margin_negative"
            android:background="@color/leia_surface_container">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/cover_detail_width"
                android:layout_height="@dimen/cover_detail_height"
                android:layout_gravity="center"
                app:cardElevation="@dimen/elevation_hero"
                app:strokeWidth="0dp">

                <include
                    android:id="@+id/cover"
                    layout="@layout/view_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/hero"
                layout="@layout/view_hero_actions" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Leia.BookTitleLarge"
                    android:textColor="@color/leia_on_background" />

                <TextView
                    android:id="@+id/author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Leia.Body"
                    android:textColor="@color/leia_on_surface_variant" />

                <TextView
                    android:id="@+id/wishes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                    android:textColor="@color/leia_on_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_wish"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    app:icon="@drawable/ic_favorite_border" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Widget.Leia.SectionTitle"
            android:text="@string/hub_copies" />

        <TextView
            android:id="@+id/no_copies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hub_no_copies"
            android:textAppearance="@style/TextAppearance.Leia.Body"
            android:textColor="@color/leia_on_surface_variant"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/copies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/compatible_title"
            style="@style/Widget.Leia.SectionTitle"
            android:text="@string/hub_compatible"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/compatible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_compatible"
            style="@style/Widget.Leia.ListAction"
            android:text="@string/action_mark_compatible"
            android:visibility="gone"
            app:icon="@drawable/ic_add" />

        <TextView
            android:id="@+id/disciplines_title"
            style="@style/Widget.Leia.SectionTitle"
            android:text="@string/hub_disciplines"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/disciplines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
