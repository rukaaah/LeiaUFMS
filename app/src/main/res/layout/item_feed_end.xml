<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <ImageView
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle"
        android:tint="@color/leia_success" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:accessibilityHeading="true"
        android:text="@string/feed_caught_up"
        android:textAppearance="@style/TextAppearance.Leia.Headline"
        android:textColor="@color/leia_on_background" />

</LinearLayout>
