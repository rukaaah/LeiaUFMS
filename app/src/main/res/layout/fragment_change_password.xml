<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:id="@+id/label_current"
                style="@style/Widget.Leia.FieldLabel"
                android:labelFor="@id/input_current"
                android:text="@string/label_current_password" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_current"
                style="@style/Widget.Leia.Field"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_current"
                    style="@style/Widget.Leia.FieldInput"
                    android:autofillHints="password"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLength="64" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/label_password"
                style="@style/Widget.Leia.FieldLabel"
                android:labelFor="@id/input_password"
                android:text="@string/label_new_password" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_password"
                style="@style/Widget.Leia.Field"
                app:helperText="@string/helper_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_password"
                    style="@style/Widget.Leia.FieldInput"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLength="64" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/label_confirm"
                style="@style/Widget.Leia.FieldLabel"
                android:labelFor="@id/input_confirm"
                android:text="@string/label_new_password_confirm" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_confirm"
                style="@style/Widget.Leia.Field"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_confirm"
                    style="@style/Widget.Leia.FieldInput"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLength="64" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_change_password" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:indeterminate="true"
                android:visibility="invisible" />
        </LinearLayout>
</ScrollView>
