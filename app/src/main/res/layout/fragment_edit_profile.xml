<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:id="@+id/label_name"
                style="@style/Widget.Leia.FieldLabel"
                android:labelFor="@id/input_name"
                android:text="@string/label_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_name"
                style="@style/Widget.Leia.Field">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_name"
                    style="@style/Widget.Leia.FieldInput"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="80" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/label_email"
                style="@style/Widget.Leia.FieldLabel"
                android:labelFor="@id/input_email"
                android:text="@string/label_email_institutional" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_email"
                style="@style/Widget.Leia.Field"
                app:helperText="@string/helper_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_email"
                    style="@style/Widget.Leia.FieldInput"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress|textNoSuggestions"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/label_course"
                style="@style/Widget.Leia.FieldLabel"
                android:labelFor="@id/input_course"
                android:text="@string/label_course" />

            <!-- Curso escolhido da lista oficial da UFMS (digite para filtrar) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_course"
                style="@style/Widget.Leia.Field.Dropdown">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/input_course"
                    style="@style/Widget.Leia.FieldInput"
                    android:completionThreshold="1"
                    android:importantForAutofill="no"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:maxLength="80" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/label_semester"
                style="@style/Widget.Leia.FieldLabel"
                android:labelFor="@id/input_semester"
                android:text="@string/label_semester" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_semester"
                style="@style/Widget.Leia.Field"
                app:helperText="@string/helper_semester">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_semester"
                    style="@style/Widget.Leia.FieldInput"
                    android:importantForAutofill="no"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/label_status"
                style="@style/Widget.Leia.FieldLabel"
                android:labelFor="@id/input_status"
                android:text="@string/label_status" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_status"
                style="@style/Widget.Leia.Field"
                app:helperText="@string/helper_status"
                app:counterEnabled="true"
                app:counterMaxLength="80">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_status"
                    style="@style/Widget.Leia.FieldInput"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLength="80" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_save" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:indeterminate="true"
                android:visibility="invisible" />
        </LinearLayout>
</ScrollView>
