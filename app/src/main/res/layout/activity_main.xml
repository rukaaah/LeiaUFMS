<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leia_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main" />

    <include
        android:id="@+id/meeting"
        layout="@layout/view_meeting_bar" />

    <!-- Barra inferior com o Início em destaque: bola central dentro da barra, sem cobrir o conteúdo (feedback 03/11) -->
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/home_ball"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/home_ball_offset"
            android:contentDescription="@string/tab_home"
            app:backgroundTint="@color/leia_primary"
            app:elevation="@dimen/elevation_hero"
            app:fabCustomSize="@dimen/home_ball"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Leia.Circle"
            app:borderWidth="0dp"
            app:maxImageSize="@dimen/icon_home_ball"
            app:srcCompat="@drawable/ic_home_filled"
            app:tint="@color/leia_on_primary" />
    </FrameLayout>
</LinearLayout>
