<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/leia_background"
        app:tabGravity="fill"
        app:tabIconTint="@color/nav_item"
        app:tabInlineLabel="true"
        app:tabIndicatorColor="@color/leia_primary"
        app:tabMinWidth="@dimen/touch_target"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/leia_primary"
        app:tabTextAppearance="@style/TextAppearance.Leia.Label"
        app:tabTextColor="@color/leia_on_surface_variant">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_inbox"
            android:text="@string/tab_received" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_send"
            android:text="@string/tab_sent" />
    </com.google.android.material.tabs.TabLayout>

    <!-- O que é cada aba, em uma linha (feedback 03/11: "o que é cada aba?") -->
    <TextView
        android:id="@+id/tab_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/screen_margin"
        android:text="@string/trades_hint_received"
        android:textAppearance="@style/TextAppearance.Leia.BodySmall"
        android:textColor="@color/leia_on_surface_variant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_l"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
