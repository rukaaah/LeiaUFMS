<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_l">

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:accessibilityHeading="true"
        android:text="@string/photo_sheet_title"
        android:textAppearance="@style/TextAppearance.Leia.Headline"
        android:textColor="@color/leia_on_background" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/option_camera"
        style="@style/Widget.Leia.ListAction"
        android:text="@string/action_take_photo"
        app:icon="@drawable/ic_camera" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/option_gallery"
        style="@style/Widget.Leia.ListAction"
        android:text="@string/action_pick_gallery"
        app:icon="@drawable/ic_gallery" />
</LinearLayout>
