<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/register_title" />

    <ScrollView
        android:id="@+id/scroll"
    android:defaultFocusHighlightEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_subtitle"
                android:textAppearance="@style/TextAppearance.Leia.Body"
                android:textColor="@color/leia_on_surface_variant" />

        <TextView
            android:id="@+id/label_name"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_name"
            android:text="@string/label_name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_name"
            style="@style/Widget.Leia.Field">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_name"
                style="@style/Widget.Leia.FieldInput"
                android:autofillHints="name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="80" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_email"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_email"
            android:text="@string/label_email_institutional" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_email"
            style="@style/Widget.Leia.Field"
            app:helperText="@string/helper_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_email"
                style="@style/Widget.Leia.FieldInput"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress|textNoSuggestions"
                android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_course"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_course"
            android:text="@string/label_course" />

        <!-- Curso escolhido da lista oficial da UFMS (digite para filtrar) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_course"
            style="@style/Widget.Leia.Field.Dropdown">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/input_course"
                style="@style/Widget.Leia.FieldInput.Dropdown"
                android:completionThreshold="1"
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLength="80" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_semester"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_semester"
            android:text="@string/label_semester" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_semester"
            style="@style/Widget.Leia.Field"
            app:helperText="@string/helper_semester">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_semester"
                style="@style/Widget.Leia.FieldInput"
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_password"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_password"
            android:text="@string/label_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_password"
            style="@style/Widget.Leia.Field"
            app:helperText="@string/helper_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_password"
                style="@style/Widget.Leia.FieldInput"
                android:autofillHints="newPassword"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLength="64" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_confirm"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_confirm"
            android:text="@string/label_password_confirm" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_confirm"
            style="@style/Widget.Leia.Field"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_confirm"
                style="@style/Widget.Leia.FieldInput"
                android:autofillHints="newPassword"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="64" />
        </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_register" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:indeterminate="true"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_have_account"
                    android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                    android:textColor="@color/leia_on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_go_login"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_go_login" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
