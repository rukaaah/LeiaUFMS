<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:defaultFocusHighlightEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_l">

        <!-- Logo: o Paliteiro sobre o livro aberto (docs/logo) -->
        <ImageView
            android:layout_width="@dimen/login_logo"
            android:layout_height="@dimen/login_logo"
            android:layout_marginStart="@dimen/login_logo_inset"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_splash" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Leia.Display"
            android:textColor="@color/leia_on_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_l"
            android:text="@string/login_tagline"
            android:textAppearance="@style/TextAppearance.Leia.Body"
            android:textColor="@color/leia_on_surface_variant" />

        <TextView
            android:id="@+id/label_email"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_email"
            android:text="@string/label_email" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_email"
            style="@style/Widget.Leia.Field">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_email"
                style="@style/Widget.Leia.FieldInput"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress|textNoSuggestions"
                android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/label_password"
            style="@style/Widget.Leia.FieldLabel"
            android:labelFor="@id/input_password"
            android:text="@string/label_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_password"
            style="@style/Widget.Leia.Field"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_password"
                style="@style/Widget.Leia.FieldInput"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="64" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/action_login" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:indeterminate="true"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account"
                android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                android:textColor="@color/leia_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_go_register"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_go_register" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
