<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/f_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/feed_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/f_dica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_lightbulb"
                    app:chipIconTint="@color/post_dica_on"
                    app:chipIconVisible="true"
                    android:text="@string/post_type_dica" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/f_procuro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_search"
                    app:chipIconTint="@color/post_procuro_on"
                    app:chipIconVisible="true"
                    android:text="@string/post_type_procuro" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/f_doacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_donate"
                    app:chipIconTint="@color/post_doacao_on"
                    app:chipIconVisible="true"
                    android:text="@string/post_type_doacao" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/f_troca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_check_circle"
                    app:chipIconTint="@color/post_troca_on"
                    app:chipIconVisible="true"
                    android:text="@string/post_type_troca" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/f_saved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feed_saved"
                    app:chipIcon="@drawable/ic_bookmark_border"
                    app:chipIconTint="@color/leia_primary"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_s"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="@dimen/fab_clearance" />

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_margin"
        android:text="@string/action_new_post"
        app:icon="@drawable/ic_edit" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
