<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingEnd="@dimen/space_l">

    <TextView
        style="@style/Widget.Leia.FieldLabel"
        android:labelFor="@id/input_title"
        android:text="@string/label_title" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_title"
        style="@style/Widget.Leia.Field">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/input_title"
            style="@style/Widget.Leia.FieldInput"
            android:completionThreshold="2"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="150"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Widget.Leia.FieldLabel"
        android:labelFor="@id/input_author"
        android:text="@string/label_author" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_author"
        style="@style/Widget.Leia.Field">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_author"
            style="@style/Widget.Leia.FieldInput"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="120" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
