<?xml version="1.0" encoding="utf-8"?>
<!-- Post do mural: card inteiro na cor da categoria (feedback 03/11), capa como post (Pinterest), pouco texto. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xxs"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="@dimen/elevation_flat"
    app:shapeAppearance="@style/ShapeAppearance.Leia.Social"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xs">

        <TextView
            android:id="@+id/tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs"
            android:drawablePadding="@dimen/space_xxs"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:paddingStart="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.Leia.Title" />

        <include
            android:id="@+id/cover"
            layout="@layout/view_cover"
            android:layout_width="match_parent"
            android:layout_height="@dimen/post_cover_height" />

        <TextView
            android:id="@+id/book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:paddingStart="@dimen/space_xxs"
            android:paddingEnd="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.Leia.BookTitleSmall" />

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="3"
            android:paddingStart="@dimen/space_xxs"
            android:paddingEnd="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.Leia.BodySmall" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:paddingStart="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.Leia.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Coração com número (dá mais tempo ao post no mural); salvar é só para você, sem número -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/react_heart"
                style="@style/Widget.Leia.ReactionButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                app:icon="@drawable/ic_favorite_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/react_save"
                style="@style/Widget.Leia.ReactionButton"
                android:layout_width="@dimen/touch_target"
                app:icon="@drawable/ic_bookmark_border" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
