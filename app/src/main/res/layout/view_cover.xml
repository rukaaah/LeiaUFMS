<?xml version="1.0" encoding="utf-8"?>
<!-- Capa: foto do exemplar ou, sem foto, as iniciais do título sobre primary_container. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cover"
    android:layout_width="@dimen/cover_width"
    android:layout_height="@dimen/cover_height"
    android:importantForAccessibility="noHideDescendants">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/cover_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/leia_primary_container"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Leia.Small" />

    <TextView
        android:id="@+id/cover_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="@dimen/space_xxs"
        android:textAppearance="@style/TextAppearance.Leia.BookTitle"
        android:textColor="@color/leia_on_primary_container" />
</FrameLayout>
