<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Leia.Body"
            android:textColor="@color/leia_on_background" />

        <FrameLayout
            android:id="@+id/map_box"
            android:layout_width="match_parent"
            android:layout_height="@dimen/map_height">

            <org.maplibre.android.maps.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/map_description" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/button_my_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/space_s"
                android:contentDescription="@string/action_my_location"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_my_location" />
        </FrameLayout>

        <TextView
            android:id="@+id/map_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_notice"
            android:drawablePadding="@dimen/space_xs"
            android:padding="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.Leia.BodySmall"
            android:textColor="@color/leia_on_background"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_wifi_off" />

        <TextView
            style="@style/Widget.Leia.SectionTitle"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:text="@string/title_points" />

        <TextView
            android:id="@+id/points_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:textAppearance="@style/TextAppearance.Leia.Body"
            android:textColor="@color/leia_on_surface_variant"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/schedule_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                android:id="@+id/selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:accessibilityLiveRegion="polite"
                android:text="@string/choose_point_first"
                android:textAppearance="@style/TextAppearance.Leia.Body"
                android:textColor="@color/leia_on_background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_date"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/choose_date"
                    app:icon="@drawable/ic_schedule" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_time"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/choose_time" />
            </LinearLayout>

            <TextView
                android:id="@+id/error_date"
                style="@style/Widget.Leia.InlineError" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_confirm_meeting" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/screen_margin"
            android:text="@string/map_attribution"
            android:textAppearance="@style/TextAppearance.Leia.Caption"
            android:textColor="@color/leia_on_surface_variant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
