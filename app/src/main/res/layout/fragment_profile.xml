<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/avatar"
                layout="@layout/view_avatar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_change_photo"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:text="@string/action_change_photo"
                app:icon="@drawable/ic_camera" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Leia.Display"
            android:textColor="@color/leia_on_background" />

        <TextView
            android:id="@+id/text_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.Leia.Body"
            android:textColor="@color/leia_on_surface_variant" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Leia.Body"
            android:textColor="@color/leia_on_background"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/credits_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_credits"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:id="@+id/text_credits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Leia.Title"
                android:textColor="@color/leia_on_tertiary_container" />

            <TextView
                android:id="@+id/text_credits_reserved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                android:textColor="@color/leia_on_tertiary_container"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/credits_hint"
                android:textAppearance="@style/TextAppearance.Leia.Caption"
                android:textColor="@color/leia_on_tertiary_container" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/metric_trades"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/value_trades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Leia.Headline"
                    android:textColor="@color/leia_on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_trades"
                    android:textAppearance="@style/TextAppearance.Leia.Caption"
                    android:textColor="@color/leia_on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/metric_rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/value_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Leia.Headline"
                    android:textColor="@color/leia_on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_rating"
                    android:textAppearance="@style/TextAppearance.Leia.Caption"
                    android:textColor="@color/leia_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_no_trades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/profile_no_trades"
            android:textAppearance="@style/TextAppearance.Leia.BodySmall"
            android:textColor="@color/leia_on_surface_variant"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/extra_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/account_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_edit_profile" />

            <TextView
                style="@style/Widget.Leia.SectionTitle"
                android:text="@string/section_account" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_password"
                style="@style/Widget.Leia.ListAction"
                android:text="@string/action_change_password"
                app:icon="@drawable/ic_lock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_inbox"
                style="@style/Widget.Leia.ListAction"
                android:text="@string/action_open_inbox"
                app:icon="@drawable/ic_notifications" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_logout"
                style="@style/Widget.Leia.ListAction"
                android:text="@string/action_logout"
                app:icon="@drawable/ic_logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
