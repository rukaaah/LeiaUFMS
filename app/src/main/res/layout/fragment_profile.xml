<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_header"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/avatar"
                    layout="@layout/view_avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.Leia.Display"
                        android:textColor="@color/leia_on_header" />

                    <TextView
                        android:id="@+id/text_course"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Leia.Body"
                        android:textColor="@color/leia_hero_secondary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Leia.Body"
                android:textColor="@color/leia_on_header"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_change_photo"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/action_change_photo"
                android:textColor="@color/leia_on_header"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/leia_on_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/metric_trades"
                    style="@style/Widget.Leia.HeaderMetric">

                    <TextView
                        android:id="@+id/value_trades"
                        style="@style/Widget.Leia.HeaderMetricValue" />

                    <TextView
                        style="@style/Widget.Leia.HeaderMetricLabel"
                        android:text="@string/metric_trades" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/metric_passed"
                    style="@style/Widget.Leia.HeaderMetric">

                    <TextView
                        android:id="@+id/value_passed"
                        style="@style/Widget.Leia.HeaderMetricValue" />

                    <TextView
                        style="@style/Widget.Leia.HeaderMetricLabel"
                        android:text="@string/metric_passed" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/metric_rating"
                    style="@style/Widget.Leia.HeaderMetric">

                    <TextView
                        android:id="@+id/value_rating"
                        style="@style/Widget.Leia.HeaderMetricValue" />

                    <TextView
                        style="@style/Widget.Leia.HeaderMetricLabel"
                        android:text="@string/metric_rating" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/credits_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_credits"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:id="@+id/text_credits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Leia.Title"
                android:textColor="@color/leia_on_tertiary_container"
                app:drawableStartCompat="@drawable/ic_donate" />

            <TextView
                android:id="@+id/text_credits_reserved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                android:textColor="@color/leia_on_tertiary_container"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/credits_hint"
                android:textAppearance="@style/TextAppearance.Leia.Caption"
                android:textColor="@color/leia_on_tertiary_container" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_no_trades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/profile_no_trades"
            android:textAppearance="@style/TextAppearance.Leia.BodySmall"
            android:textColor="@color/leia_on_surface_variant"
            android:visibility="gone" />

        <TextView
            style="@style/Widget.Leia.SectionTitle"
            android:text="@string/profile_shelf_title" />

        <LinearLayout
            android:id="@+id/shelf_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelf_covers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/extra_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/account_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_edit_profile" />

            <TextView
                style="@style/Widget.Leia.SectionTitle"
                android:text="@string/section_account" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_shelf"
                style="@style/Widget.Leia.ListAction"
                android:text="@string/action_open_shelf"
                app:icon="@drawable/ic_library" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_password"
                style="@style/Widget.Leia.ListAction"
                android:text="@string/action_change_password"
                app:icon="@drawable/ic_lock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_disputes"
                style="@style/Widget.Leia.ListAction"
                android:text="@string/action_disputes"
                android:visibility="gone"
                app:icon="@drawable/ic_gavel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_points"
                style="@style/Widget.Leia.ListAction"
                android:text="@string/action_manage_points"
                android:visibility="gone"
                app:icon="@drawable/ic_map" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_logout"
                style="@style/Widget.Leia.ListAction"
                android:text="@string/action_logout"
                app:icon="@drawable/ic_logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
