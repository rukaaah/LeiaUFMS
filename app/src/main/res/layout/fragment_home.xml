<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/fab_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                android:id="@+id/hello"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.Leia.Display"
                android:textColor="@color/leia_on_background" />

            <TextView
                android:id="@+id/credits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_credit_pill"
                android:drawablePadding="@dimen/space_xxs"
                android:minHeight="@dimen/size_32"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Leia.Label"
                android:textColor="@color/leia_on_tertiary_container" />

            <!-- Coração: abre os desejos; o número diz quantos já estão disponíveis -->
            <FrameLayout
                android:id="@+id/wishes_button"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="@dimen/space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/open_wishes"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/heart_button"
                    android:layout_height="@dimen/heart_button"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_tertiary"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/space_xs"
                    android:src="@drawable/ic_favorite"
                    app:tint="@color/leia_tertiary" />

                <TextView
                    android:id="@+id/wishes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_count_badge"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:minWidth="@dimen/count_badge"
                    android:paddingStart="@dimen/space_xxs"
                    android:paddingEnd="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Leia.Caption"
                    android:textColor="@color/leia_on_success_container"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:drawablePadding="@dimen/space_s"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:text="@string/home_search"
            android:textAppearance="@style/TextAppearance.Leia.Body"
            android:textColor="@color/leia_on_surface_variant"
            app:drawableStartCompat="@drawable/ic_search" />

        <LinearLayout
            android:id="@+id/for_you"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Widget.Leia.HomeSection"
                android:text="@string/home_for_you" />

            <LinearLayout
                android:id="@+id/for_you_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin" />
        </LinearLayout>

        <TextView
            android:id="@+id/near_title"
            style="@style/Widget.Leia.HomeSection"
            android:text="@string/home_near" />

        <TextView
            android:id="@+id/near_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:textAppearance="@style/TextAppearance.Leia.BodySmall"
            android:textColor="@color/leia_on_surface_variant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/near_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/near_invite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_notice"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_s"
            android:visibility="gone">

            <TextView
                android:id="@+id/near_invite_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/space_xs"
                android:text="@string/home_near_invite"
                android:textAppearance="@style/TextAppearance.Leia.BodySmall"
                android:textColor="@color/leia_on_background"
                app:drawableStartCompat="@drawable/ic_walk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/near_invite_action"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_activate_location" />
        </LinearLayout>

        <TextView
            android:id="@+id/course_title"
            android:visibility="gone"
            style="@style/Widget.Leia.HomeSection"
            android:text="@string/home_course" />

        <TextView
            android:id="@+id/course_sub"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:textAppearance="@style/TextAppearance.Leia.BodySmall"
            android:textColor="@color/leia_on_surface_variant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/course_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />


        <TextView
            android:id="@+id/because_title"
            style="@style/Widget.Leia.HomeSection"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/because_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/genre_title"
            style="@style/Widget.Leia.HomeSection"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/genre_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            style="@style/Widget.Leia.HomeSection"
            android:text="@string/home_genres" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/genres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                app:singleLine="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/fresh_title"
            style="@style/Widget.Leia.HomeSection"
            android:text="@string/home_new" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fresh_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_all"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/screen_margin"
            android:text="@string/home_all" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
